{
  "openapi": "3.1.1",
  "info": {
    "title": "TheSampleApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7080"
    },
    {
      "url": "http://localhost:5150"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "TheSampleApi"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "TheSampleApi"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/vehicles": {
      "get": {
        "tags": [
          "TheSampleApi"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VehicleModel"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VehicleModel": {
        "required": [
          "make",
          "model",
          "category"
        ],
        "type": "object",
        "properties": {
          "vehicleID": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ownerID": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "dailyRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          },
          "isAvailable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "TheSampleApi"
    }
  ]
}