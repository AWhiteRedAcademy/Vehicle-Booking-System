{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch C# API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      // 💡 Mishap Fix: Match the string 'backend.dll' below with your actual project name!
      "program": "${workspaceFolder}/backend/bin/Debug/net8.0/backend.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "now listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Launch React Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Launch Both (API & React)",
      "configurations": ["Launch C# API", "Launch React Frontend"]
    }
  ]
}
